# Copy to .env.local for local development, or add these in Vercel:
# Project → Settings → Environment Variables. Both are optional.

# Lets the Gift Finder use Claude to read descriptions and explain picks.
# Without it, the finder uses rule-based keyword matching.
ANTHROPIC_API_KEY=

# Optional: an n8n (or any) webhook that receives each order request as JSON.
ORDER_WEBHOOK_URL=
