# Copy to .env.local for local development, or add these in Vercel:
# Project → Settings → Environment Variables. All are optional.

# AI matching for the Gift Finder. Set ONE of these; Gemini is used if both are set.
# Without either, the finder uses rule-based keyword matching.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# Optional: an n8n (or any) webhook that receives each order request as JSON.
ORDER_WEBHOOK_URL=
